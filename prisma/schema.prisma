// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH (NextAuth / Auth.js) ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // for credentials provider
  leaderboardOptIn Boolean  @default(true)
  displayName   String?   // optional public name on leaderboard
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  // App relations
  learningSessions LearningSession[]
  dsaProblems      DsaProblem[]
  revisionItems    RevisionItem[]
  notes            Note[]
  blogPosts        BlogPost[]
  studyTimers      StudyTimer[]
  performanceLogs  PerformanceLog[]
  attachments      Attachment[]
  skills           Skill[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== CORE LEARNING ====================

enum ConfidenceLevel {
  LEARNING      // just read / watched
  PRACTICED     // implemented examples
  REVISION      // can recall without notes
  INTERVIEW_READY // can explain + answer follow-ups
}

enum Category {
  JAVA
  DSA
  DBMS
  OS
  SYSTEM_DESIGN
  NETWORKING
  BEHAVIORAL
  CAREER
  EXAM
  SOFT_SKILLS
  PROJECT
  OTHER
}

model LearningSession {
  id              String          @id @default(cuid())
  userId          String
  title           String
  topic           String
  category        Category        @default(OTHER)
  date            DateTime        @default(now())
  durationMinutes Int             // actual time spent
  conceptsCovered String[]        // array of concept names
  practiceNotes   String?         @db.Text
  keyTakeaway     String?         @db.Text
  confidence      ConfidenceLevel @default(LEARNING)
  revisionNeeded  Boolean         @default(false)
  nextStep        String?
  scorePoints     Int             @default(0) // calculated based on duration + confidence + consistency
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([userId, date])
  @@index([category])
  @@map("learning_sessions")
}

// ==================== DSA TRACKER ====================

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  TODO
  ATTEMPTED
  SOLVED
  REVISIT
}

model DsaProblem {
  id          String        @id @default(cuid())
  userId      String
  title       String
  link        String?       // LeetCode / GFG / etc.
  difficulty  Difficulty    @default(MEDIUM)
  status      ProblemStatus @default(TODO)
  topicTags   String[]      // arrays, trees, dp, etc.
  notes       String?       @db.Text
  timeSpent   Int?          // minutes
  solvedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("dsa_problems")
}

// ==================== REVISION QUEUE ====================

model RevisionItem {
  id          String    @id @default(cuid())
  userId      String
  topic       String
  concept     String
  reason      String?   // why it needs revision
  priority    Int       @default(1) // 1 = high, 3 = low
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@map("revision_items")
}

// ==================== NOTES (self-messaging / quick notes) ====================

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPinned])
  @@map("notes")
}

// ==================== BLOG / REFLECTIONS ====================

model BlogPost {
  id          String   @id @default(cuid())
  userId      String
  title       String
  slug        String
  content     String   @db.Text
  excerpt     String?
  tags        String[]
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, isPublished])
  @@map("blog_posts")
}

// ==================== TIMER & PERFORMANCE ====================

model StudyTimer {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?      // calculated on stop
  topic       String?
  sessionId   String?   // optional link to LearningSession
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("study_timers")
}

model PerformanceLog {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @default(now()) @db.Date
  totalMinutes  Int      @default(0)
  sessionsCount Int      @default(0)
  problemsSolved Int     @default(0)
  scorePoints   Int      @default(0)
  streakDays    Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("performance_logs")
}


// ==================== ATTACHMENTS (screenshots / docs) ====================

model Attachment {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  fileName  String
  fileType  String   // image/png, application/pdf, etc.
  fileSize  Int      // bytes
  url       String   // /uploads/...
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("attachments")
}


// ==================== SKILLS (derived from sessions) ====================

enum SkillType {
  TECH
  TOOL
  SOFT
  DOMAIN
}

model Skill {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          SkillType @default(TECH)
  level         Int       @default(1) // 1-5 derived or manual
  sessionCount  Int       @default(0)
  totalMinutes  Int       @default(0)
  lastPracticed DateTime?
  source        String    @default("auto") // auto | manual
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("skills")
}
